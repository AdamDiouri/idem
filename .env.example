# Local settings for docker compose. `make up` copies this file to .env the
# first time; edit .env (never committed), not this file.

# --- Secrets: compose refuses to start without them --------------------------

# Postgres password. Letters, digits, '-' and '_' only (it goes into a URL).
# Postgres applies it when it first creates its volume: after changing it, run
# `make reset` (deletes the local database) before `make up`.
POSTGRES_PASSWORD=idem-local-change-me

# Password of idem_app_user, the restricted login the API, workers and sweepers
# use. Postgres creates the login when it first creates its volume; after
# changing this (or on a volume created before the login existed), run
# `make app-user`. Letters, digits, '-' and '_' only (it goes into a URL).
IDEM_APP_DB_PASSWORD=idem-app-local-change-me

# Bearer token for the demo client "demo" (at least 16 characters).
#   curl -H "Authorization: Bearer $IDEM_DEMO_TOKEN" ...
IDEM_DEMO_TOKEN=demo-token-change-me-0123

# Shared by the fake provider (signs webhooks) and the API (verifies them),
# at least 16 characters.
IDEM_WEBHOOK_SECRET=whsec-local-change-me-0123

# --- Demo tuning (optional; these are the defaults) --------------------------

# How long an accepted payout stays pending at the fake provider.
#FAKEPROVIDER_PAYOUT_SETTLE=2s
# How long a waiting payout waits before workers poll it (production: 10m).
#IDEM_CALLBACK_DEADLINE=5s
